{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "aspera-connect",
  "version": "0.1.0-beta.1",
  "identifier": "com.asperaconnect.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Aspera Connect",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Mirror and control Android from Linux",
    "longDescription": "Aspera Connect is a free, open-source Linux companion for Android — screen mirroring, wireless pairing, files, and more. Free forever, local-first, no account.",
    "publisher": "Aspera Connect Contributors",
    "homepage": "https://github.com/aspera-connect/aspera-connect",
    "copyright": "Copyright 2026 Aspera Connect Contributors",
    "linux": {
      "deb": {
        "depends": ["adb"],
        "recommends": ["scrcpy"],
        "section": "utils",
        "priority": "optional",
        "desktopTemplate": "../../../packaging/linux/aspera-connect.desktop",
        "files": {
          "/usr/share/doc/aspera-connect/TESTING.md": "../../../TESTING.md",
          "/usr/share/doc/aspera-connect/README.md": "../../../README.md",
          "/usr/share/applications/aspera-connect.desktop": "../../../packaging/linux/aspera-connect.desktop"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
