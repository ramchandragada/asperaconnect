<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_hero_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/space_lg"
            android:paddingTop="@dimen/space_xl"
            android:paddingRight="@dimen/space_lg"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mark" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Aspera.Brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASPERA" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.04"
                        android:text="@string/tagline"
                        android:textAllCaps="true"
                        android:textColor="@color/accent"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linkBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@drawable/bg_status_warn"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    android:id="@+id/linkPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_warn"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="Off"
                    android:textAllCaps="true"
                    android:textColor="@color/amber_ink"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/linkTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/status_idle_title"
                    android:textColor="@color/ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/linkDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/status_idle_detail"
                    android:textColor="@color/ink_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <TextView
                    style="@style/Text.Aspera.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ip_label" />

                <TextView
                    android:id="@+id/ipText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="—"
                    android:textColor="@color/ink"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/portText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Port 17891"
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <EditText
                android:id="@+id/pinInput"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:importantForAutofill="no"
                android:visibility="gone" />

            <Button
                android:id="@+id/listenButton"
                style="@style/Widget.Aspera.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:elevation="4dp"
                android:minHeight="72dp"
                android:text="@string/listen_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/listen_sub"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/scanQrButton"
                style="@style/Widget.Aspera.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:minHeight="56dp"
                android:text="@string/scan_qr" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/scan_qr_sub"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/pasteQrButton"
                style="@style/Widget.Aspera.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:minHeight="56dp"
                android:text="@string/paste_qr" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/paste_qr_sub"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/stopButton"
                style="@style/Widget.Aspera.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/stop" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/footer"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="v0.3.5"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
