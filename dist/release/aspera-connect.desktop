[Desktop Entry]
Name=Aspera Connect
GenericName=Click-to-call
Comment=Aspera Connect — PC to phone click-to-call (QR pair)
Exec=/usr/bin/aspera-connect %u
TryExec=/usr/bin/aspera-connect
Icon=aspera-connect
Terminal=false
Type=Application
Categories=Utility;Network;Telephony;
Keywords=aspera;connect;asperaconnect;android;phone;mirror;tel;call;crm;qr;click-to-call;
MimeType=x-scheme-handler/tel;x-scheme-handler/callto;
StartupNotify=true
StartupWMClass=aspera-connect
