[Desktop Entry]
Name=Aspera Connect
Comment=Mirror and control Android from Linux — including tel: click-to-call
Exec=/usr/bin/aspera-connect %u
TryExec=/usr/bin/aspera-connect
Icon=aspera-connect
Terminal=false
Type=Application
Categories=Utility;Network;Telephony;
Keywords=android;scrcpy;adb;phone;mirror;tel;call;crm;
MimeType=x-scheme-handler/tel;x-scheme-handler/callto;
StartupNotify=true
StartupWMClass=aspera-connect
